{
  "name": "bhp-dprkp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && opennextjs-cloudflare build --skipNextBuild",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:repair-stock": "node scripts/repair-stock.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:rapikan-kategori": "node scripts/rapikan-kategori.mjs",
    "db:import-master": "node scripts/import-master-resmi.mjs",
    "d1:migrate:local": "wrangler d1 migrations apply bhp_dprkp_db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply bhp_dprkp_db --remote",
    "d1:seed:local": "wrangler d1 execute bhp_dprkp_db --local --file=./scripts/seed.sql",
    "d1:seed:remote": "wrangler d1 execute bhp_dprkp_db --remote --file=./scripts/seed.sql"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.39.3",
    "jose": "^6.0.8",
    "lucide-react": "^1.16.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.6.1",
    "better-sqlite3": "^11.8.1",
    "drizzle-kit": "^0.30.4",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "wrangler": "^4.152.0",
    "@opennextjs/cloudflare": "^1.20.13"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}