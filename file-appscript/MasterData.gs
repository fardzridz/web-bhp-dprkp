function importExcelMasterData() {
  requireRole_(['ADMIN']);
  const lock = LockService.getScriptLock(); lock.waitLock(30000);
  try {
    const categoryIds = ensureNamedMasters_('CATEGORIES', 'KTG', EXCEL_MASTER_DATA.items.map(function (x) { return x[2]; }));
    const unitIds = ensureNamedMasters_('UNITS', 'STN', EXCEL_MASTER_DATA.items.map(function (x) { return x[1]; }));
    const existingItems = rows_('ITEMS'); let addedItems = 0;
    EXCEL_MASTER_DATA.items.forEach(function (x, i) {
      if (existingItems.some(function (r) { return normalize_(r.NAMA) === normalize_(x[0]); })) return;
      const item = { ID: makeId_('BRG'), KODE: 'BRG-' + String(i + 1).padStart(4, '0'), NAMA: x[0], KATEGORI_ID: categoryIds[normalize_(x[2])], SATUAN_ID: unitIds[normalize_(x[1])], STOK_MINIMUM: 0, STATUS: APP.STATUS.ACTIVE, DIBUAT_PADA: now_(), DIUBAH_PADA: now_() };
      insert_('ITEMS', item); existingItems.push(item); addedItems++;
    });
    const existingVendors = rows_('VENDORS'); let addedVendors = 0;
    EXCEL_MASTER_DATA.vendors.forEach(function (name) {
      if (existingVendors.some(function (r) { return normalize_(r.NAMA) === normalize_(name); })) return;
      const vendor = { ID: makeId_('VND'), NAMA: name, ALAMAT: '', TELEPON: '', STATUS: APP.STATUS.ACTIVE, DIBUAT_PADA: now_(), DIUBAH_PADA: now_() };
      insert_('VENDORS', vendor); existingVendors.push(vendor); addedVendors++;
    });
    audit_('IMPORT', 'MASTER_EXCEL', 'MASTER-2026', null, { barangDitambahkan: addedItems, vendorDitambahkan: addedVendors });
    return { barangSumber: EXCEL_MASTER_DATA.items.length, barangDitambahkan: addedItems, vendorSumber: EXCEL_MASTER_DATA.vendors.length, vendorDitambahkan: addedVendors };
  } finally { lock.releaseLock(); }
}

function ensureNamedMasters_(key, prefix, names) {
  const current = rows_(key); const ids = {};
  current.forEach(function (r) { ids[normalize_(r.NAMA)] = r.ID; });
  names.forEach(function (name) {
    const normalized = normalize_(name); if (ids[normalized]) return;
    const row = { ID: makeId_(prefix), NAMA: name, STATUS: APP.STATUS.ACTIVE, DIBUAT_PADA: now_(), DIUBAH_PADA: now_() };
    insert_(key, row); ids[normalized] = row.ID;
  });
  return ids;
}
